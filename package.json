{
  "name": "svelte-widgets",
  "version": "1.0.0",
  "description": "Accessible, keyboard-friendly Svelte components and attachments",
  "keywords": [
    "command-palette",
    "components",
    "form",
    "input",
    "multi-select",
    "popover",
    "svelte"
  ],
  "homepage": "https://janosh.github.io/svelte-widgets",
  "bugs": "https://github.com/janosh/svelte-widgets/issues",
  "license": "MIT",
  "author": "Janosh Riebesell <janosh.riebesell@gmail.com>",
  "repository": "https://github.com/janosh/svelte-widgets",
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "svelte": "./dist/index.js",
  "exports": {
    "./ButtonGroup.svelte": {
      "types": "./dist/ButtonGroup.svelte.d.ts",
      "svelte": "./dist/ButtonGroup.svelte",
      "default": "./dist/ButtonGroup.svelte"
    },
    "./CommandMenu.svelte": {
      "types": "./dist/CommandMenu.svelte.d.ts",
      "svelte": "./dist/CommandMenu.svelte",
      "default": "./dist/CommandMenu.svelte"
    },
    "./DraggablePane.svelte": {
      "types": "./dist/DraggablePane.svelte.d.ts",
      "svelte": "./dist/DraggablePane.svelte",
      "default": "./dist/DraggablePane.svelte"
    },
    "./Masonry.svelte": {
      "types": "./dist/Masonry.svelte.d.ts",
      "svelte": "./dist/Masonry.svelte",
      "default": "./dist/Masonry.svelte"
    },
    "./MultiSelect.svelte": {
      "types": "./dist/MultiSelect.svelte.d.ts",
      "svelte": "./dist/MultiSelect.svelte",
      "default": "./dist/MultiSelect.svelte"
    },
    "./PageSearch.svelte": {
      "types": "./dist/PageSearch.svelte.d.ts",
      "svelte": "./dist/PageSearch.svelte",
      "default": "./dist/PageSearch.svelte"
    },
    "./Toast.svelte": {
      "types": "./dist/Toast.svelte.d.ts",
      "svelte": "./dist/Toast.svelte",
      "default": "./dist/Toast.svelte"
    },
    "./Toc.svelte": {
      "types": "./dist/Toc.svelte.d.ts",
      "svelte": "./dist/Toc.svelte",
      "default": "./dist/Toc.svelte"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./attachments": {
      "types": "./dist/attachments.d.ts",
      "default": "./dist/attachments.js"
    },
    "./utils": {
      "types": "./dist/utils.d.ts",
      "default": "./dist/utils.js"
    },
    "./heading-anchors": {
      "types": "./dist/heading-anchors.d.ts",
      "default": "./dist/heading-anchors.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    },
    "./live-examples": {
      "types": "./dist/live-examples/index.d.ts",
      "default": "./dist/live-examples/index.js"
    },
    "./live-examples/create-highlighter": {
      "types": "./dist/live-examples/create-highlighter.d.ts",
      "default": "./dist/live-examples/create-highlighter.js"
    },
    "./clipboard": {
      "types": "./dist/clipboard.svelte.d.ts",
      "default": "./dist/clipboard.svelte.js"
    },
    "./dialogs": {
      "types": "./dist/dialogs.svelte.d.ts",
      "default": "./dist/dialogs.svelte.js"
    },
    "./file-drop": {
      "types": "./dist/file-drop.d.ts",
      "default": "./dist/file-drop.js"
    },
    "./fullscreen": {
      "types": "./dist/fullscreen.svelte.d.ts",
      "default": "./dist/fullscreen.svelte.js"
    },
    "./print": {
      "types": "./dist/print.d.ts",
      "default": "./dist/print.js"
    },
    "./text-search": {
      "types": "./dist/text-search.d.ts",
      "default": "./dist/text-search.js"
    },
    "./toast-queue": {
      "types": "./dist/toast-queue.svelte.d.ts",
      "default": "./dist/toast-queue.svelte.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build:site": "vp build && pagefind --site build --exclude-selectors \"pre, details\"",
    "test": "vp test --run && playwright test",
    "test:coverage": "vp test --run --coverage",
    "test:package": "npm run package && npm pack --dry-run && vp build --config tests/package-smoke/vite.config.ts",
    "package": "svelte-package && find dist \\( -name '*.js' -o -name '*.d.ts' -o -name '*.svelte' \\) -type f -exec perl -pi -e \"s/(\\.\\.?\\/[^'\\\"]*)\\.ts(['\\\"])/\\1.js\\2/g\" {} + && find dist -name 'readme.svelte' -delete",
    "prepublishOnly": "npm run package",
    "changelog": "npx tsx https://github.com/janosh/workflows/raw/refs/heads/main/scripts/make-release-notes.ts"
  },
  "devDependencies": {
    "@janosh/vite-config": "github:janosh/dotfiles",
    "@playwright/test": "^1.61.1",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.1",
    "@sveltejs/package": "2.5.8",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@types/node": "^26.1.1",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "@vitest/coverage-v8": "4.1.10",
    "@wooorm/starry-night": "^3.10.0",
    "happy-dom": "^20.11.0",
    "mdsvex": "^0.12.8",
    "pagefind": "^1.5.2",
    "svelte": "^5.56.7",
    "typescript": "^6.0.3",
    "vite": "^8.1.5",
    "vite-plus": "0.2.5"
  },
  "peerDependencies": {
    "@wooorm/starry-night": "^3.0.0",
    "svelte": "^5.48.0",
    "vite": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "@wooorm/starry-night": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "overrides": {
    "svelte": "$svelte"
  }
}
